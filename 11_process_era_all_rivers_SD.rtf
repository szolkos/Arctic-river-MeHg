\f0\fs24 \cf0 // ======================================================================================================== //\
// Name: 1_process_era_all_rivers_SD\
// Purpose: Extract MAAT, MAP, and SDs for six Arctic-GRO watersheds (Russia: 2020\'962021; NA: 2020\'962024)\
// ======================================================================================================== //\
\
// ERA5 Land monthly aggregate\
var era5_monthly_aggr = ee.ImageCollection("ECMWF/ERA5_LAND/MONTHLY_AGGR");\
\
// MOD44W water mask (2003\'962015 mean)\
var mod44w = ee.ImageCollection('MODIS/006/MOD44W');\
var water_mask = mod44w\
  .filterDate('2003-01-01', '2015-12-31')\
  .select('water_mask')\
  .mean()\
  .eq(0);\
\
// Watersheds\
var ob = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/ob");\
var yenisey = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/yenisey");\
var lena = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/lena");\
var kolyma = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/kolyma");\
var yukon = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/yukon");\
var mackenzie = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/mackenzie");\
\
// Create dictionary of watersheds\
var rivers = \{\
  'ob': ob,\
  'yenisey': yenisey,\
  'lena': lena,\
  'kolyma': kolyma,\
  'yukon': yukon,\
  'mackenzie': mackenzie\
\};\
\
// Water mask function\
var maskWater = function(image) \{\
  return image.updateMask(water_mask);\
\};\
\
// Set pixel scale\
var scale_exp = 10000;\
\
// Define custom year ranges per region\
var russianYears = [2020, 2021];\
var northAmericanYears = [2020, 2021, 2022, 2023, 2024];\
\
// Function to determine year range based on river name\
var getYears = function(name) \{\
  var russian = ['ob', 'yenisey', 'lena', 'kolyma'];\
  return russian.indexOf(name) > -1 ? russianYears : northAmericanYears;\
\};\
\
// Function to compute annual stats for each watershed\
var processWatershed = function(name, fc) \{\
  \
  var years = getYears(name);\
  var features = ee.List([]);\
  \
  years.forEach(function(year) \{\
    \
    var era_year = era5_monthly_aggr\
      .filterDate(year + '-01-01', year + '-12-31')\
      .select(['temperature_2m', 'total_precipitation_sum'])\
      .map(maskWater);\
    \
    // Mean annual temperature (\'b0C)\
    var temp_mean = era_year.select('temperature_2m').mean().subtract(273.15);\
    // Total annual precipitation (mm)\
    var precip_tot = era_year.select('total_precipitation_sum').sum().multiply(1000);\
    \
    // Compute watershed statistics: mean and SD\
    var temp_stats = temp_mean.reduceRegion(\{\
      reducer: ee.Reducer.mean().combine(\{\
        reducer2: ee.Reducer.stdDev(),\
        sharedInputs: true\
      \}),\
      geometry: fc.geometry(),\
      scale: scale_exp,\
      maxPixels: 1e13\
    \});\
    \
    var precip_stats = precip_tot.reduceRegion(\{\
      reducer: ee.Reducer.mean().combine(\{\
        reducer2: ee.Reducer.stdDev(),\
        sharedInputs: true\
      \}),\
      geometry: fc.geometry(),\
      scale: scale_exp,\
      maxPixels: 1e13\
    \});\
    \
    // Create feature for this year and watershed\
    var f = ee.Feature(null, \{\
      'watershed': name,\
      'year': year,\
      'temp_c_mean': ee.Number(temp_stats.get('temperature_2m_mean')),\
      'temp_c_sd': ee.Number(temp_stats.get('temperature_2m_stdDev')),\
      'precip_mm_tot_mean': ee.Number(precip_stats.get('total_precipitation_sum_mean')),\
      'precip_mm_tot_sd': ee.Number(precip_stats.get('total_precipitation_sum_stdDev'))\
    \});\
    \
    features = features.add(f);\
  \});\
  \
  return ee.FeatureCollection(features);\
\};\
\
// Loop through rivers and merge results\
var allFeatures = ee.FeatureCollection([]);\
for (var key in rivers) \{\
  allFeatures = allFeatures.merge(processWatershed(key, rivers[key]));\
\}\
\
// Print & Export\
print('MAAT & MAP (mean + SD):', allFeatures);\
\
Export.table.toDrive(\{\
  collection: allFeatures,\
  description: 'era5_MAAT_MAP_SD_2020_2024',\
  fileFormat: 'CSV',\
  folder: 'Hg & MeHg 2020-2024'\
\});\
}