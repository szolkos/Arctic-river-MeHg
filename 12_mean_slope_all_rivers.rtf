\f0\fs24 \cf0 // ======================================================================================================== //\
// Name: 12_mean_slope_all_rivers\
// Purpose: Calculate mean and standard deviation of watershed slope using Copernicus GLO-30 DEM for six Arctic rivers\
// ======================================================================================================== //\
\
// --- Watersheds ---\
var ob = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/ob");\
var yenisey = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/yenisey");\
var lena = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/lena");\
var kolyma = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/kolyma");\
var yukon = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/yukon");\
var mackenzie = ee.FeatureCollection("projects/ee-szolkos/assets/arctic-gro/mackenzie_no_peel");\
\
// Dictionary of rivers\
var rivers = \{\
  'ob': ob,\
  'yenisey': yenisey,\
  'lena': lena,\
  'kolyma': kolyma,\
  'yukon': yukon,\
  'mackenzie': mackenzie\
\};\
\
// --- Load GLO-30 DEM ---\
var demCollection = ee.ImageCollection('COPERNICUS/DEM/GLO30');\
\
// --- Function to calculate mean & SD of slope for one watershed ---\
var computeSlope = function(name, fc) \{\
  \
  // Merge DEM tiles and compute mean DEM\
  var dem = demCollection\
    .filterBounds(fc)\
    .mean()\
    .reproject(\{crs: 'EPSG:4326', scale: 30\});\
  \
  // Compute slope (degrees)\
  var slope = ee.Terrain.slope(dem);\
  \
  // Clip slope to watershed boundary\
  var slopeClipped = slope.clip(fc);\
  \
  // Compute mean and SD of slope\
  var slopeStats = slopeClipped.reduceRegion(\{\
    reducer: ee.Reducer.mean().combine(\{\
      reducer2: ee.Reducer.stdDev(),\
      sharedInputs: true\
    \}),\
    geometry: fc.geometry(),\
    scale: 30,\
    maxPixels: 1e13\
  \});\
  \
  // Return as feature\
  return ee.Feature(null, \{\
    'watershed': name,\
    'mean_slope_deg': slopeStats.get('slope_mean'),\
    'sd_slope_deg': slopeStats.get('slope_stdDev')\
  \});\
\};\
\
// --- Loop over all rivers ---\
var allSlopes = ee.FeatureCollection([]);\
for (var key in rivers) \{\
  allSlopes = allSlopes.merge(ee.FeatureCollection([computeSlope(key, rivers[key])]));\
\}\
\
// --- Print results ---\
print('Mean & SD of slope (\uc0\u730 ) for each watershed:', allSlopes);\
\
// --- Export to Drive ---\
Export.table.toDrive(\{\
  collection: allSlopes,\
  description: 'GLO30_mean_sd_slope_rivers',\
  fileFormat: 'CSV',\
  folder: 'Hg & MeHg 2020-2024'\
\});\
}